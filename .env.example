# ===========================================
# Queen Less Kings - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Queenless Kings"

# ===========================================
# Spotify API (Free)
# Get these from: https://developer.spotify.com/dashboard
# ===========================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ARTIST_ID=

# ===========================================
# Google APIs (Free)
# Get these from: https://console.cloud.google.com
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Service account JSON key (base64 encoded or raw JSON)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Google Drive folder ID for media storage
GOOGLE_DRIVE_FOLDER_ID=
# Google Calendar ID for events
GOOGLE_CALENDAR_ID=

# ===========================================
# Email - Resend (Free: 10,000 emails/month)
# Get API key from: https://resend.com
# ===========================================
RESEND_API_KEY=
EMAIL_TO=bookings@queenlesskingsband.com
EMAIL_FROM=Queenless Kings <noreply@queenlesskings.com>

# ===========================================
# Cloudflare Turnstile (Free CAPTCHA)
# Get keys from: https://dash.cloudflare.com/
# ===========================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===========================================
# Redis (Rate Limiting)
# Option 1: Upstash Cloud (Free: 10,000 commands/day)
# Get credentials from: https://upstash.com
# ===========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Option 2: Local Redis (Self-hosted on homelab)
# Example: redis://localhost:6379
# Example with auth: redis://:password@192.168.1.100:6379
# ===========================================
REDIS_URL=

# ===========================================
# Social Media Links
# ===========================================
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/queenlesskingsmusic/
NEXT_PUBLIC_YOUTUBE=https://www.youtube.com/@queenlesskings8794
NEXT_PUBLIC_SPOTIFY=https://open.spotify.com/artist/11SfEIcAyAMs9UdphqUF82
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/queenlesskingsmusic/
NEXT_PUBLIC_TIKTOK=https://www.tiktok.com/@queenlesskingsofficial
NEXT_PUBLIC_BANDCAMP=https://queenlesskings.bandcamp.com
NEXT_PUBLIC_SOUNDCLOUD=https://soundcloud.com/user-598831235

# ===========================================
# Analytics (Optional - Vercel Analytics is free)
# ===========================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ===========================================
# Auth (Optional - for admin features)
# ===========================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
